# Copy to .env and replace all sample values before deployment.
POSTGRES_DB=uptime_monitor
POSTGRES_USER=uptime_monitor
POSTGRES_PASSWORD=CHANGE_ME_TO_A_UNIQUE_STRONG_PASSWORD
JWT_SECRET=REPLACE_WITH_OUTPUT_FROM_OPENSSL_RAND_HEX_32
APP_PORT=8080
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
TZ=Europe/Istanbul
SSL_LABS_ENABLED=true
SSLYZE_TIMEOUT=120
REDIS_URL=redis://redis:6379/0
COOKIE_SECURE=false
